,"kjvName":"Adria","esvName":"Adriatic Sea","lat":42.415,"lon":16.3735,"type":"Water","aliases":[],"events":["e382","e381"],"peopleBorn":[],"peopleDied":[],"verses":[27882],"verseCount":1,"dict":"(Acts 27:27 ; RSV, \"the sea of Adria\"), the Adriatic Sea, including in Paul's time the whole of the Mediterranean lying between Crete and Sicily. It is the modern Gulf of Venice, the <i> Mare Superum_ of the Romans, as distinguished from the </i> Mare Inferum_ or Tyrrhenian Sea.","comment":"water"},"adullam_31":{"id":"adullam_31","name":"Adullam","kjvName":"Adullam","esvName":"Adullam","lat":31.657354,"lon":34.999242,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6145,6237,7788,8666,10688,11421,12618,22594],"verseCount":8},"adummim_32":{"id":"adummim_32","name":"Adummim","kjvName":"Adummim","esvName":"Adummim","lat":31.817585,"lon":35.361646,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6209,6310],"verseCount":2},"aenon_33":{"id":"aenon_33","name":"Aenon","kjvName":"Aenon","esvName":"Aenon","lat":32.398936,"lon":35.54351,"aliases":[],"events":["e275"],"peopleBorn":[],"peopleDied":[],"verses":[26143],"verseCount":1},"ahava_34":{"id":"ahava_34","name":"Ahava","kjvName":"Ahava","esvName":"Ahava","lat":33.625197,"lon":42.786647,"type":"Water","subType":"River","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[12216,12222,12232],"verseCount":3},"ahlab_35":{"id":"ahlab_35","name":"Ahlab","kjvName":"Ahlab","esvName":"Ahlab","lat":33.02498036,"lon":35.44544658,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6540],"verseCount":1},"ai_36":{"id":"ai_36","name":"Ai","kjvName":"Ai","esvName":"Ai","lat":31.9166759,"lon":35.2615767,"type":"City","aliases":[],"events":["e71"],"peopleBorn":[],"peopleDied":[],"verses":[306,321,5978,5979,5980,5981,6003,6004,6005,6011,6012,6013,6014,6016,6018,6019,6020,6022,6023,6025,6026,6027,6028,6030,6031,6040,6065,6066,6139,12055,12452],"verseCount":31},"ai_37":{"i