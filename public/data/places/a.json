id":"ashnah_105","name":"Ashnah","kjvName":"Ashnah","esvName":"Ashnah","lat":31.8099,"lon":34.9365,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6235,6245],"verseCount":2},"ashtaroth_106":{"id":"ashtaroth_106","name":"Ashtaroth","kjvName":"Ashtaroth","esvName":"Ashtaroth","lat":32.837408,"lon":36.029358,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[4896,6047,6134,6166,6185,10525],"verseCount":6},"ashteroth-karnaim_107":{"id":"ashteroth-karnaim_107","name":"Ashteroth-karnaim","kjvName":"Ashteroth-karnaim","esvName":"Ashteroth-karnaim","lat":32.76666667,"lon":36.01666667,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[341],"verseCount":1},"asia_108":{"id":"asia_108","name":"Asia","kjvName":"Asia","esvName":"Asia","lat":39.64014749138555,"lon":31.03325453,"type":"Region","precision":"Related-Surrounding","aliases":[],"events":["e350","e364","e365","e368","e380","e381"],"peopleBorn":[],"peopleDied":[],"verses":[26958,27110,27489,27595,27607,27611,27612,27642,27644,27691,27787,27857,28341,28795,28808,29824,30375,30701],"verseCount":18,"dict":"is used to denote Proconsular Asia, a Roman province which embraced the western parts of Asia Minor, and of which Ephesus was the capital, in Acts 2:9 ; 6:9 ; 16:6 ; Acts 19:10 Acts 19:22 ; Acts 20:4 Acts 20:16 Acts 20:18 , etc., and probably Asia Minor in Acts 19:26 Acts 19:27 ; 21:27 ; 24:18 ; 27:2 . Proconsular Asia contained the seven churches of the Apocalypse (Revelation 1:11). The \"chiefs of Asia\" (Acts 19:31) were certain wealthy citizens who were annually elected to preside over the games and religious festivals of the several cities to which they belonged. Some of these \"Asiarchs\" were Paul's friends.","comment":"region"},"asshur_109":{"id":"asshur_109","name":"Asshur","kjvName":"Asshur","esvName":"Asshur","lat":36.35941,"lon":43.152887,"type":"City","precision":"Related-Surrounding","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[4468,4470,15249,21144],"verseCount":4},"assos_110":{"id":"assos_110","name":"Assos","kjvName":"Assos","esvName":"Assos","lat":39.490601,"lon":26.337061,"type":"City","aliases":[],"events":["e368"],"peopleBorn":[],"peopleDied":[],"verses":[27639,27640],"verseCount":2,"dict":"a sea-port town of Proconsular Asia, in the district of Mysia, on the north shore of the Gulf of Adramyttium. Paul came hither on foot along the Roman road from Troas (Acts 20:13 Acts 20:14), a distance of 20 miles. It was about 30 miles distant from Troas by sea. The island of Lesbos lay opposite it, about 7 miles distant."},"assyria_111":{"id":"assyria_111","name":"Assyria","kjvName":"Assyria","esvName":"Assyria","lat":36.50969,"lon":43.2282,"type":"Region","precision":"Related-Surrounding","aliases":[],"events":["e87"],"peopleBorn":[],"peopleDied":[],"verses":[44,245,676,9944,9945,9954,9970,9971,9972,9973,9981,9986,9987,9988,9989,10006,10007,10009,10010,10031,10033,10035,10037,10038,10040,10041,10043,10047,10052,10054,10055,10057,10065,10067,10069,10071,10072,10078,10081,10093,10097,10104,10194,10434,10454,11780,11784,11785,11833,11876,11879,11882,11884,11885,11886,11896,11897,11919,12112,12173,12543,17799,17800,17802,17811,17814,17855,17862,17895,17900,18027,18028,18029,18030,18033,18035,18090,18164,18331,18332,18334,18338,18343,18345,18346,18348,18356,18358,18360,18362,18363,18370,18373,18385,18389,18396,18983,19001,20183,20184,21014,21233,22165,22189,22203,22211,22231,22245,22251,22253,22639,22676,22730,22818,23026,23027],"verseCount":116,"comment":"region"},"atad_112":{"id":"atad_112","name":"Atad","kjvName":"Atad","esvName":"Atad","precision":"Unlocated","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[1516,1517],"verseCount":2},"ataroth_113":{"id":"ataroth_113","name":"Ataroth","kjvName":"Ataroth","esvName":"Ataroth","lat":31.6,"lon":35.7,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[4721,4752],"verseCount":2},"ataroth_114":{"id":"ataroth_114","name":"Ataroth","kjvName":"Ataroth","esvName":"Ataroth","lat":31.85891795409998,"lon":35.12831317484221,"type":"City","precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6267,6272],"verseCount":2},"ataroth-addar_115":{"id":"ataroth-addar_115","name":"Ataroth-addar","kjvName":"Ataroth-addar","esvName":"Ataroth-addar","lat":31.85891795409998,"lon":35.12831317484221,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6270],"verseCount":1},"athach_116":{"id":"athach_116","name":"Athach","kjvName":"Athach","esvName":"Athach","precision":"Unlocated","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[8008],"verseCount":1},"atharim_117":{"id":"atharim_117","name":"Atharim","kjvName":"Atharim","esvName":"Atharim","lat":30.880918,"lon":34.63062,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[4341],"verseCount":1},"athens_118":{"id":"athens_118","name":"Athens","kjvName":"Athens","esvName":"Athens","lat":37.971687,"lon":23.726464,"type":"City","aliases":[],"events":["e359"],"peopleBorn":[],"peopleDied":[],"verses":[27538,27539,27545,27558,29591],"verseCount":5,"dict":"the capital of Attica, the most celebrated city of the ancient world, the seat of Greek literature and art during the golden period of Grecian history. Its inhabitants were fond of novelty (Acts 17:21), and were remarkable for their zeal in the worship of the gods. It was a sarcastic saying of the Roman satirist that it was \"easier to find a god at Athens than a man.\" On his second missionary journey Paul visited this city (Acts 17:15 ; Compare 1 Thessalonians 3:1), and delivered in the Areopagus his famous speech (17:22-31). The altar of which Paul there speaks as dedicated \"to the [properly \"an\"] unknown God\" (23) was probably one of several which bore the same inscription. It is supposed that they originated in the practice of letting loose a flock of sheep and goats in the streets of Athens on the occasion of a plague, and of offering them up in sacrifice, at the spot where they lay down, \"to the god concerned.\""},"atroth-shophan_119":{"id":"atroth-shophan_119","name":"Atroth-shophan","kjvName":"Atroth-shophan","esvName":"Atroth-shophan","lat":31.9617,"lon":35.9115,"type":"City","precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[4753],"verseCount":1},"attalia_120":{"id":"attalia_120","name":"Attalia","kjvName":"Attalia","esvName":"Attalia","lat":36.8839,"lon":30.70541,"type":"City","aliases":[],"events":["e343","e338"],"peopleBorn":[],"peopleDied":[],"verses":[27439],"verseCount":1},"aven_121":{"id":"aven_121","name":"Aven","kjvName":"Aven","esvName":"Aven","lat":31.93053921,"lon":35.22103275,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[22233],"verseCount":1},"avith_122":{"id":"avith_122","name":"Avith","kjvName":"Avith","esvName":"Avith","lat":30.734691,"lon":35.60625,"precision":"Related-Surrounding","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[1075,10298],"verseCount":2},"avva_123":{"id":"avva_123","name":"Avva","kjvName":"Avva","esvName":"Avva","lat":34.467725,"lon":41.964955,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[10007],"verseCount":1},"avvim_124":{"id":"avvim_124","name":"Avvim","kjvName":"Avvim","esvName":"Avvim","lat":31.53577362133176,"lon":35.09409986578734,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6316],"verseCount":1},"ayyah_125":{"id":"ayyah_125","name":"Ayyah","kjvName":"Ayyah","esvName":"Ayyah","lat":31.5248177,"lon":34.43336472,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[10563],"verseCount":1},"azal_126":{"id":"azal_126","name":"Azal","kjvName":"Azal","esvName":"Azal","lat":31.77809503341373,"lon":35.2471976093501,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses