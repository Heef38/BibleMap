":35.24719761,"type":"Mountain","aliases":["mount Olivet"],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[8419,23072,23827,23960,24084,24641,24720,24780,25768,25903,26382],"verseCount":11},"mount_paran_850":{"id":"mount_paran_850","name":"Mount Paran","kjvName":"mount Paran","esvName":"Mount Paran","lat":29.151667,"lon":33.541944,"type":"Mountain","precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[5812,22771],"verseCount":2},"mount_perazim_851":{"id":"mount_perazim_851","name":"Mount Perazim","kjvName":"mount Perazim","esvName":"Mount Perazim","lat":31.756332,"lon":35.223059,"type":"Mountain","precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[18185],"verseCount":1},"mount_seir_852":{"id":"mount_seir_852","name":"Mount Seir","kjvName":"mount Seir","esvName":"Mount Seir","lat":30.734691,"lon":35.60625,"type":"Mountain","precision":"Related-Surrounding","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[4894,4939,4943,10427,11597,11609,21346,21347,21351,21359],"verseCount":10,"comment":"mountain range"},"mount_seir_853":{"id":"mount_seir_853","name":"Mount Seir","kjvName":"mount Seir","esvName":"Mount Seir","lat":31.783333,"lon":34.994,"type":"Mountain","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6212],"verseCount":1},"mount_shapher_854":{"id":"mount_shapher_854","name":"Mount Shapher","kjvName":"mount Shapher","esvName":"Mount Shepher","lat":30.317396,"lon":35.407152,"type":"Mountain","precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[4783,4784],"verseCount":2},"mount_sinai_855":{"id":"mount_sinai_855","name":"Mount Sinai","kjvName":"mount Sinai","esvName":"Mount Sinai","lat":28.58771,"lon":33.921682,"type":"Mountain","aliases":["Horeb","Mount Horeb"],"events":["e127"],"peopleBorn":[],"peopleDied":[],"verses":[2037,2044,2046,2049,2193,2438,2498,2500,2525,2528,3470,3570,3604,3693,4583,12524,27146,27154,29155,29156],"verseCount":20,"dict":"of Sin (the moon god), called also Horeb, the name of the mountain district which was reached by the Hebrews in the third month after the Exodus. Here they remained encamped for about a whole year. Their journey from the Red Sea to this encampment, including all the windings of the route, was about 150 miles. The last twenty-two chapters of Exodus, together with the whole of Leviticus and Nu ch. 1-11, contain a record of all the transactions which occurred while they were here. From Rephidim (Exodus 17:8-13) the Israelites journeyed forward through the Wady Solaf and Wady esh-Sheikh into the plain of er-Rahah, \"the desert of Sinai,\" about 2 miles long and half a mile broad, and encamped there \"before the mountain.\" The part of the mountain range, a protruding lower bluff, known as the Ras Sasafeh (Sufsafeh), rises almost perpendicularly from this plain, and is in all probability the Sinai of history. Dean Stanley thus describes the scene:, \"The plain itself is not broken and uneven and narrowly shut in, like almost all others in the range, but presents a long retiring sweep, within which the people could remove and stand afar off. The cliff, rising like a huge altar in front of the whole congregation, and visible against the sky in lonely grandeur from end to end of the whole plain, is the very image of the 'mount that might be touched,' and from which the voice of God might be heard far and wide over the plain below.\" This was the scene of the giving of the law. From the Ras Sufsafeh the law was proclaimed to the people encamped below in the plain of er-Rahah. During the lengthened period of their encampment here the Israelites passed through a very memorable experience. An immense change passed over them. They are now an organized nation, bound by covenant engagement to serve the Lord their God, their ever-present divine Leader and Protector. At length, in the second month of the second year of the Exodus, they move their camp and march forward according to a prescribed order. After three days they reach the \"wilderness of Paran,\" the \"et-Tih\", i.e., \"the desert\", and here they make their first encampment. At this time a spirit of discontent broke out amongst them, and the Lord manifested his displeasure by a fire which fell on the encampment and inflicted injury on them. Moses called the place Taberah (q.v.), Numbers 11:1-3 . The journey between Sinai and the southern boundary of the Promised Land (about 150 miles) at Kadesh was accomplished in about a year. (See MAP facing page 204.)"},"mount_sion_856":{"id":"mount_sion_856","name":"Mount Sion","kjvName":"mount Sion","esvName":"Mount Sirion","lat":33.41615982,"lon":35.85725618,"type":"Mountain","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[5052],"verseCount":1},"mount_tabor_857":{"id":"mount_tabor_857","name":"Mount Tabor","kjvName":"mount Tabor","esvName":"Mount Tabor","lat":32.6869564,"lon":35.39091304,"type":"Mountain","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6605,6611,6613],"verseCount":3},"mount_zalmon_858":{"id":"mount_zalmon_858","name":"Mount Zalmon","kjvName":"mount Zalmon","esvName":"Mount Zalmon","lat":32.23293814,"lon":35.2730418,"type":"Mountain","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6802],"verseCount":1},"mount_zemaraim_859":{"id":"mount_zemaraim_859","name":"Mount Zemaraim","kjvName":"mount Zemaraim","esvName":"Mount Zemaraim","lat":31.910999,"lon":35.45728,"type":"Mountain","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[11457],"verseCount":1},"mount_zion_860":{"id":"mount_zion_860","name":"Mount Zion","kjvName":"mount Zion","esvName":"Mount Zion","lat":31.776667,"lon":35.234167,"type":"Mountain","precision":"Related-Within","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[10092,14636,14645,15050,15181,16111,17738,17825,17862,18004,18118,18201,18254,18384,20460,22343,22527,22531,22627,30234,30927],"verseCount":21},"mozah_862":{"id":"mozah_862","name":"Mozah","kjvName":"Mozah","esvName":"Mozah","lat":31.802641,"lon":35.158376,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6319],"verseCount":1},"myra_864":{"id":"myra_864","name":"Myra","kjvName":"Myra","esvName":"Myra","lat":36.258393,"lon":29.985559,"type":"City","aliases":[],"events":["e380","e381"],"peopleBorn":[],"peopleDied":[],"verses":[27860],"verseCount":1,"dict":"one of the chief towns of Lycia, in Asia Minor, about 2 1/2 miles from the coast (Acts 27:5). Here Paul removed from the Adramyttian ship in which he had sailed from Caesarea, and entered into the Alexandrian ship, which was afterwards wrecked at Melita (27:39-44)."},"mysia_865":{"id":"mysia_865","name":"Mysia","kjvName":"Mysia","esvName":"Mysia","lat":40.25,"lon":27.75,"type":"Region","precision":"Rough","aliases":[],"events":["e350"],"peopleBorn":[],"peopleDied":[],"verses":[27490,27491],"verseCount":2,"dict":"a province in the north-west of Asia Minor. On his first voyage to Europe (Acts 16:7 Acts 16:8) Paul passed through this province and embarked at its chief port Troas."}}