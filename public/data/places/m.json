],"peopleDied":[],"verses":[27641,27643,29890],"verseCount":3,"dict":"(Miletum, 2 Timothy 4:20), a seaport town and the ancient capital of Ionia, about 36 miles south of Ephesus. On his voyage from Greece to Syria, Paul touched at this port, and delivered that noble and pathetic address to the elders (\"presbyters,\" ver. 28) of Ephesus recorded in Acts 20:15-35 . The site of Miletus is now some 10 miles from the coast. (See EPHESIANS, EPISTLE TO .)"},"millo_802":{"id":"millo_802","name":"Millo","kjvName":"Millo","esvName":"Millo","lat":31.777444,"lon":35.234935,"precision":"Related-Within","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[8141,9066,9075,9135,10681,11880],"verseCount":6},"minni_803":{"id":"minni_803","name":"Minni","kjvName":"Minni","esvName":"Minni","lat":40.6,"lon":44.6,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[20239],"verseCount":1},"minnith_804":{"id":"minnith_804","name":"Minnith","kjvName":"Minnith","esvName":"Minnith","lat":31.75,"lon":35.85,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6862,21138],"verseCount":2},"mishal_805":{"id":"mishal_805","name":"Mishal","kjvName":"Mishal","esvName":"Mishal","lat":33.046264,"lon":35.172513,"type":"City","precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6347,6411],"verseCount":2},"misrephoth-maim_806":{"id":"misrephoth-maim_806","name":"Misrephoth-maim","kjvName":"Misrephoth-maim","esvName":"Misrephoth-maim","lat":33.118952,"lon":35.139434,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6115,6160],"verseCount":2,"comment":"now Narouq"},"mithkah_807":{"id":"mithkah_807","name":"Mithkah","kjvName":"Mithkah","esvName":"Mithkah","lat":30.317396,"lon":35.407152,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[4788,4789],"verseCount":2},"mitylene_808":{"id":"mitylene_808","name":"Mitylene","kjvName":"Mitylene","esvName":"Mitylene","lat":39.10772,"lon":26.55529,"type":"City","aliases":[],"events":["e368"],"peopleBorn":[],"peopleDied":[],"verses":[27640],"verseCount":1,"dict":"the chief city of the island of Lesbos, on its east coast, in the AEgean Sea. Paul, during his third missionary journey, touched at this place on his way from Corinth to Judea (Acts 20:14), and here tarried for a night. It lies between Assos and Chios. It is now under the Turkish rule, and bears the name of Metelin."},"mizpah_809":{"id":"mizpah_809","name":"Mizpah","kjvName":"Mizpah","esvName":"Mizpah","lat":32.56526757,"lon":36.00555931,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[922,6828,6840,6858,6863,22153],"verseCount":6},"mizpah_810":{"id":"mizpah_810","name":"Mizpah","kjvName":"Mizpah","esvName":"Mizpah","lat":33.28177,"lon":35.573371,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6110],"verseCount":1},"mizpah_811":{"id":"mizpah_811","name":"Mizpah","kjvName":"Mizpah","esvName":"Mizpah","lat":31.83273947,"lon":35.18016286,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[7055,7057,7103,7107,7110,7357,7358,7359,7363,7364,7368,7435,10245,10247,11515,12334,12342,12346,19947,19949,19951,19953,19954,19956,19958,19960,19963,19967,19971,19973],"verseCount":30},"mizpeh_812":{"id":"mizpeh_812","name":"Mizpeh","kjvName":"Mizpeh","esvName":"Mizpeh","lat":31.83273947,"lon":35.18016286,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6319],"verseCount":1},"mizpeh_813":{"id":"mizpeh_813","name":"Mizpeh","kjvName":"Mizpeh","esvName":"Mizpeh","lat":31.56485056116292,"lon":34.8467256730566,"precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6240],"verseCount":1},"mizpeh_814":{"id":"mizpeh_814","name":"Mizpeh","kjvName":"Mizpeh","esvName":"Mizpeh","lat":31.1813258,"lon":35.70214779,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[7790],"verseCount":1},"moab_815":{"id":"moab_815","