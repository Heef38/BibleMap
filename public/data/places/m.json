 years he probably visited it for a third time (Phil 2:24 ; 1 Timothy 1:3). The first convert made by Paul in Europe was (Acts 16:13-15) Lydia (q.v.), a \"seller of purple,\" residing in Philippi, the chief city of the eastern division of Macedonia.","comment":"region"},"machpelah_748":{"id":"machpelah_748","name":"Machpelah","kjvName":"Machpelah","esvName":"Machpelah","lat":31.52464795,"lon":35.11073465,"type":"Landmark","subType":"Cave","aliases":[],"events":["e88"],"peopleBorn":[],"peopleDied":[],"verses":[580,588,590,667,1503,1519],"verseCount":6},"madmannah_749":{"id":"madmannah_749","name":"Madmannah","kjvName":"Madmannah","esvName":"Madmannah","lat":31.391668,"lon":34.940502,"aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6233,10355],"verseCount":2},"madmen_750":{"id":"madmen_750","name":"Madmen","kjvName":"Madmen","esvName":"Madmen","lat":31.49684514,"lon":35.78284105,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[20082],"verseCount":1},"madmenah_751":{"id":"madmenah_751","name":"Madmenah","kjvName":"Madmenah","esvName":"Madmenah","lat":31.8,"lon":35.25,"type":"City","precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[17881],"verseCount":1},"madon_752":{"id":"madon_752","name":"Madon","kjvName":"Madon","esvName":"Madon","lat":32.799879,"lon":35.459506,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[6108,6149],"verseCount":2},"magadan_753":{"id":"magadan_753","name":"Magadan","kjvName":"Magadan","esvName":"Magadan","lat":32.84733495,"lon":35.52293618,"type":"City","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[23672],"verseCount":1},"magog_754":{"id":"magog_754","name":"Magog","kjvName":"Magog","esvName":"Magog","lat":46,"lon":47,"type":"Region","precision":"Rough","aliases":[],"events":[],"peopleBorn":[],"peopleDied":[],"verses":[21427,21454,31046],"verseCount":3},"mahalab_755":{"id":"mahalab_755","name":"Mahalab","kjvN