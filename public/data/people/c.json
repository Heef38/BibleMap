dia_946","name":"Claudia","title":"Claudia","gender":"Female","min":66,"max":66,"aka":[],"father":[],"mother":[],"partners":[],"children":[],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[],"verses":[29891],"verseCount":1,"status":"wip","name_meaning":{"meaning":"Claudius, lame","hebrew":"קְלוֹדְיָה","translit":"qəlodəyah","strongs":"none","greek":"Κλαυδία","greekTranslit":"Klaudia"}},"claudius_947":{"id":"claudius_947","name":"Claudius","title":"Claudius (4th Roman Emperor)","gender":"Male","min":43,"max":54,"aka":[],"father":[],"mother":[],"partners":[],"children":[],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[],"verses":[27335,27559],"verseCount":2,"dict":"lame. The fourth Roman emperor. He succeeded Caligula (A.D. 41). Though in general he treated the Jews, especially those in Asia and Egypt, with great indulgence, yet about the middle of his reign (A.D. 49) he banished them all from Rome (Acts 18:2). In this edict the Christians were included, as being, as was supposed, a sect of Jews. The Jews, however soon again returned to Rome. During the reign of this emperor, several persecutions of the Christians by the Jews took place in the dominions of Herod Agrippa, in one of which the apostle James was \"killed\" (12:2). He died A.D. 54.","status":"publish","name_meaning":{"hebrew":"קְלוֹדְיוֹס","translit":"qlodəyos","strongs":"none","greek":"Κλαύδιος","greekTranslit":"Klaúdios"}},"claudius_948":{"id":"claudius_948","name":"Claudius","title":"Claudius Lysias","gender":"Male","min":60,"max":60,"aka":[],"father":[],"mother":[],"partners":[],"children":[],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[],"verses":[27760],"verseCount":1,"dict":"Claudius Lysias, a Greek who, having obtained by purchase the privilege of Roman citizenship, took the name of Claudius (Acts 21:31-40 ; 22:28 ; 23:26).","status":"publish","name_meaning":{"hebrew":"קְלוֹדְיוֹס","translit":"qlodəyos","strongs":"none","greek":"Κλαύδιος","greekTranslit":"Klaúdios"}