ans by the Jews took place in the dominions of Herod Agrippa, in one of which the apostle James was \"killed\" (12:2). He died A.D. 54.","status":"publish"},"claudius_948":{"id":"claudius_948","name":"Claudius","title":"Claudius Lysias","gender":"Male","min":60,"max":60,"aka":[],"father":[],"mother":[],"partners":[],"children":[],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[],"verses":[27760],"verseCount":1,"dict":"Claudius Lysias, a Greek who, having obtained by purchase the privilege of Roman citizenship, took the name of Claudius (Acts 21:31-40 ; 22:28 ; 23:26).","status":"publish"},"clement_949":{"id":"clement_949","name":"Clement","title":"Clement","gender":"Male","min":64,"max":64,"aka":[],"father":[],"mother":[],"partners":[],"children":[],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[],"verses":[29445],"verseCount":1,"status":"wip"},"cleophas_950":{"id":"cleophas_950","name":"Cleophas","title":"Cleophas","gender":"Male","min":33,"max":33,"aka":["Cleopas"],"father":[],"mother":[],"partners":["mary_1940"],"children":[],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[],"verses":[26009,26850],"verseCount":2,"status":"wip"},"col-hozeh_951":{"id":"col-hozeh_951","name":"Col-hozeh","title":"Col-hozeh","gender":"Male","min":-445,"max":-445,"aka":[],"father":[],"mother":[],"partners":[],"children":["shallun_2527"],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[],"verses":[12342],"verseCount":1,"status":"wip"},"col-hozeh_952":{"id":"col-hozeh_952","name":"Col-hozeh","title":"Col-hozeh","gender":"Male","min":-445,"max":-445,"aka":[],"father":["hazaiah_1464"],"mother":[],"partners":[],"children":["baruch_409"],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[],"verses":[12593],"verseCount":1,"status":"wip"},"conaniah_953":{"id":"conaniah_953","name":"Conaniah","title":"Conaniah","gender":"Male","min":0,"max":0,"aka":[],"father":[],"mother":[],"partners":[],"children":[],"siblings":[],"birthPlace":[],"deathPlace":[],"events":[